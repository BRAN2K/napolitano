{
	"schemaVersion": 1,
	"id": "napolitano",
	"version": "${version}",
	"name": "Napolitano",
	"description": "A simple Fabric mod.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/napolitano/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.example.napolitano.Napolitano",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.example.napolitano.client.NapolitanoClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"napolitano.mixins.json",
		{
			"config": "napolitano.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}